{
  "name": "@authboundry/core",
  "version": "1.15.0",
  "description": "The authority boundary for an application.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "authboundry": "bin/authboundry.js"
  },
  "authboundry": {
    "nativePlatforms": [
      "darwin-arm64",
      "darwin-x64",
      "linux-arm64",
      "linux-x64"
    ]
  },
  "files": [
    "bin/",
    "dist/",
    "native/",
    "templates/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "build": "sh scripts/build-npm-package.sh",
    "test": "node test/verify-feltdb-version.js && node test/felt-db-integration.test.js && node --test clients/js/authboundry.test.js test/npm-package.test.js test/cli-launcher.test.js && sh scripts/check-public-naming.sh",
    "prepack": "npm run build",
    "verify:package": "sh scripts/verify-npm-package.sh",
    "publish:packages": "sh scripts/publish-packages.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/authboundry.git"
  },
  "bugs": {
    "url": "https://github.com/rkendel1/authboundry/issues"
  },
  "homepage": "https://authboundry.com",
  "license": "UNLICENSED",
  "keywords": [
    "authorization",
    "identity",
    "multi-tenant",
    "delegation",
    "agent",
    "service-identity",
    "authority",
    "application-security",
    "access-control",
    "security"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@feltdb/core": "0.10.0",
    "@mailerport/sdk": "^0.1.0"
  },
  "optionalDependencies": {
    "@authboundry/core-darwin-arm64": "1.15.0",
    "@authboundry/core-darwin-x64": "1.15.0",
    "@authboundry/core-linux-arm64": "1.15.0",
    "@authboundry/core-linux-x64": "1.15.0"
  }
}
